rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      let role = getUserRole();
      return role == 'super_admin' || role == 'school_admin';
    }
    
    function isSuperAdmin() {
      return getUserRole() == 'super_admin';
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // NOTE: When using Firebase Admin SDK (NestJS backend), these rules are BYPASSED.
    // The backend must independently enforce authorization on every request.
    // These rules serve as a defense-in-depth layer for any direct client access.

    // Users collection - admins can read/write, users can read own doc
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow create: if isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'isActive']));
      allow delete: if isSuperAdmin();
    }

    // Students collection
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        getUserRole() == 'teacher' ||
        resource.data.userId == request.auth.uid ||
        resource.data.guardianUserId == request.auth.uid
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Guardians collection
    match /guardians/{guardianId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Teacher profiles
    match /teacherProfiles/{teacherId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Academic years
    match /academicYears/{yearId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Classes
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Sections
    match /sections/{sectionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Subjects
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Enrollments
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'teacher' ||
        resource.data.studentUserId == request.auth.uid ||
        resource.data.guardianUserId == request.auth.uid
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        isAdmin() || getUserRole() == 'teacher'
      );
      allow delete: if isAdmin();
    }

    // Exams
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Marks - sensitive, only authorized access
    match /marks/{markId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'teacher' ||
        resource.data.studentUserId == request.auth.uid ||
        resource.data.guardianUserId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (
        isAdmin() || getUserRole() == 'teacher'
      );
      allow delete: if isAdmin();
    }

    // Results - published results can be read by student/parent
    match /results/{resultId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'teacher' ||
        (resource.data.status == 'published' && (
          resource.data.studentUserId == request.auth.uid ||
          resource.data.guardianUserId == request.auth.uid
        ))
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // School settings
    match /schoolSettings/{settingId} {
      allow read: if true; // Public settings for website
      allow write: if isAdmin();
    }

    // Admissions
    match /admissions/{admissionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'admission_officer' ||
        resource.data.applicantEmail == request.auth.token.email
      );
      allow create: if true; // Public admission form
      allow update: if isAuthenticated() && (
        isAdmin() || getUserRole() == 'admission_officer'
      );
      allow delete: if isSuperAdmin();
    }

    // Fee structures
    match /feeStructures/{feeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (
        isAdmin() || getUserRole() == 'accountant'
      );
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'accountant' ||
        resource.data.studentUserId == request.auth.uid ||
        resource.data.guardianUserId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (
        isAdmin() || getUserRole() == 'accountant'
      );
      allow delete: if isSuperAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'accountant' ||
        resource.data.studentUserId == request.auth.uid ||
        resource.data.guardianUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() || getUserRole() == 'accountant'
      );
      allow update, delete: if isSuperAdmin();
    }

    // Notices - published ones are public
    match /notices/{noticeId} {
      allow read: if resource.data.isPublished == true || (isAuthenticated() && isAdmin());
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // Events
    match /events/{eventId} {
      allow read: if resource.data.isPublished == true || (isAuthenticated() && isAdmin());
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // Gallery albums
    match /galleryAlbums/{albumId} {
      allow read: if resource.data.isPublished == true || (isAuthenticated() && isAdmin());
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // Books
    match /books/{bookId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (
        isAdmin() || getUserRole() == 'librarian'
      );
    }

    // Book transactions
    match /bookTransactions/{transactionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'librarian' ||
        resource.data.borrowerUserId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (
        isAdmin() || getUserRole() == 'librarian'
      );
      allow delete: if isSuperAdmin();
    }

    // Audit logs - super admin only
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isSuperAdmin();
      allow create: if isAuthenticated(); // Backend creates these
      allow update, delete: if false; // Immutable
    }

    // Dashboard stats
    match /dashboardStats/{statId} {
      allow read: if isAuthenticated() && isAdmin();
      allow write: if false; // Only backend updates these
    }

    // Result templates config
    match /resultTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
